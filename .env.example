# Copy to .env and fill in. Never commit .env.
# Required: at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# PostgreSQL for the backend. Use a dedicated least-privilege role, not postgres/postgres.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/telecom_forensics

# Login brute-force protection (defaults shown)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
